[0mจำเป็นต้องจับคู่กัน:[0m

[1;33m[โค้ด / แผนภาพ : text][0m
[32mget()[0m
[32m ↓[0m
[32mprocess[0m
[32m ↓[0m
[32mtask_done()[0m

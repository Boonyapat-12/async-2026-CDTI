[1;36m17. Flow รวมทั้งบท[0m
[90m==================[0m

[1;33m[โค้ด / แผนภาพ : text][0m
[32m                  ┌──────────────────┐[0m
[32m                  │    Producer      │[0m
[32m                  │   สร้างงาน       │[0m
[32m                  └────────┬─────────┘[0m
[32m                           │[0m
[32m                         put()[0m
[32m                           │[0m
[32m                           ▼[0m
[32m                  ┌──────────────────┐[0m
[32m                  │      Queue       │[0m
[32m                  │      FIFO        │[0m
[32m                  │ Buffer / Decouple│[0m
[32m                  └────────┬─────────┘[0m
[32m                           │[0m
[32m                         get()[0m
[32m                           │[0m
[32m              ┌────────────┴────────────┐[0m
[32m              ▼                         ▼[0m
[32m       ┌─────────────┐          ┌─────────────┐[0m
[32m       │ Consumer 1  │          │ Consumer 2  │[0m
[32m       └─────────────┘          └─────────────┘[0m
[32m              │                         │[0m
[32m              └────────────┬────────────┘[0m
[32m                           ▼[0m
[32m                     task_done()[0m
[32m                           │[0m
[32m                           ▼[0m
[32m                     queue.join()[0m
[32m                           │[0m
[32m                           ▼[0m
[32m                  Graceful Shutdown[0m
[1;33m[จบโค้ด / แผนภาพ][0m

[90m----------------------------------------------------------------[0m

[1;36m18. จำแบบสั้นที่สุด 🧠[0m
[90m=====================[0m

[0mQueue = ตัวกลางจัดลำดับงาน[0m

[0mFIFO = เข้าก่อนออกก่อน[0m

[0mEnqueue = เข้า Tail[0m

[0mDequeue = ออก Head[0m

[0mProducer = สร้างงาน[0m

[0mConsumer = ประมวลผลงาน[0m

[0masyncio.Queue = Queue สำหรับ Coroutine[0m

[0mget() ตอน Queue ว่าง = await แล้ว Event Loop ไปทำงานอื่น[0m

[0mput() ตอน Queue เต็ม = await → Backpressure[0m


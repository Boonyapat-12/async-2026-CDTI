[1;36m13. Coupon Producer–Consumer[0m
[90m============================[0m

[0mเอกสารมีตัวอย่าง Coupon จำนวน 20 ใบ[0m

[0mProducer:[0m

[1;33m[โค้ด / แผนภาพ : text][0m
[32mสร้าง Coupon 1[0m
[32mสร้าง Coupon 2[0m
[32mสร้าง Coupon 3[0m
[32m...[0m
[32mสร้าง Coupon 20[0m
[1;33m[จบโค้ด / แผนภาพ][0m

[0mแล้วใส่ลง:[0m

[1;33m[โค้ด / แผนภาพ : python][0m
[32masyncio.Queue()[0m
[1;33m[จบโค้ด / แผนภาพ][0m

[0mConsumer ดึง Coupon ไปประมวลผล/เก็บสะสม[0m

[0m📌 หน้า 59–62: Coupon Producer–Consumer[0m

[90m----------------------------------------------------------------[0m

[1;36mโครงสร้างหลัก[0m
[90m-------------[0m

[1;33m[โค้ด / แผนภาพ : python][0m
[32masync def producer(queue, total_coupons):[0m
[32m    for i in range(1, total_coupons + 1):[0m
[32m        coupon = f"COUPON-{i:02d}"[0m
[32m        await queue.put(coupon)[0m
[32m        await asyncio.sleep(...)[0m
[1;33m[จบโค้ด / แผนภาพ][0m

[0mConsumer:[0m

[1;33m[โค้ด / แผนภาพ : python][0m
[32masync def consumer(queue, consumer_name):[0m
[32m    while True:[0m
[32m        coupon = await queue.get()[0m

[32m        if coupon is None:[0m
[32m            queue.task_done()[0m
[32m            break[0m

[32m        # process coupon[0m

[32m        queue.task_done()[0m
[1;33m[จบโค้ด / แผนภาพ][0m

[0mใน main():[0m

[1;33m[โค้ด / แผนภาพ : python][0m
[32mqueue = asyncio.Queue()[0m

[32mprod_task = asyncio.create_task([0m
[32m    producer(queue, TOTAL_COUPONS)[0m
[32m)[0m

[32mcons_task = asyncio.create_task([0m
[32m    consumer(queue, "Consumer_01")[0m
[32m)[0m

[32mawait prod_task[0m
[32mawait queue.join()[0m

[32mawait queue.put(None)[0m
[32mawait cons_task[0m
[1;33m[จบโค้ด / แผนภาพ][0m


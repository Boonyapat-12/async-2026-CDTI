[1;33m[โค้ด / แผนภาพ : text][0m
[32m              Server[0m
[32m                 │[0m
[32m       ┌─────────┴─────────┐[0m
[32m       ▼                   ▼[0m
[32mListen Commands        Game Loop[0m
[32m       │                   │[0m
[32mRedis Pub/Sub        Move / Fire[0m
[32m                         │[0m
[32m                      Collision[0m
[32m                         │[0m
[32m                         ▼[0m
[32m                    Publish State[0m
[1;33m[จบโค้ด / แผนภาพ][0m

[0m📌 หน้า 6: Asyncio Event Loop[0m

[90m----------------------------------------------------------------[0m

[1;36m6. asyncio.create_task()[0m
[90m========================[0m

[0mServer ใช้:[0m

[1;33m[โค้ด / แผนภาพ : python][0m
[32masyncio.create_task()[0m
[1;33m[จบโค้ด / แผนภาพ][0m

[0mเพื่อสร้าง Task หลัก 2 ตัวให้ทำงาน Concurrent บน Single-Threaded Event Loop[0m

[0mตัวอย่างแนวคิด:[0m

[1;33m[โค้ด / แผนภาพ : python][0m
[32masyncio.create_task(listen_commands())[0m
[32masyncio.create_task(game_loop())[0m
[1;33m[จบโค้ด / แผนภาพ][0m

[0mหมายความว่า:[0m

[1;33m[โค้ด / แผนภาพ : text][0m
[32mlisten_commands()[0m
[32m       │[0m
[32m       ├──────────────┐[0m
[32m       │              │[0m
[32m       ▼              ▼[0m
[32m Event Loop      game_loop()[0m
[1;33m[จบโค้ด / แผนภาพ][0m

[0mทั้งสอง Task สามารถสลับกันทำงานได้โดยไม่ต้องใช้ Thread แยกสำหรับแต่ละงาน[0m

[0m📌 หน้า 7: Asynchronous Implementation Details[0m

[90m----------------------------------------------------------------[0m

[1;36m7. Game Loop 10 FPS[0m
[90m===================[0m

[0mGame Loop ทำงานทุก:[0m

[1;33m[โค้ด / แผนภาพ : text][0m
[32m0.1 second[0m
[1;33m[จบโค้ด / แผนภาพ][0m

[0mหรือ:[0m

[1;33m[โค้ด / แผนภาพ : text][0m
[32m10 FPS[0m
[1;33m[จบโค้ด / แผนภาพ][0m

[0mใช้:[0m

[1;33m[โค้ด / แผนภาพ : python][0m
[32mawait asyncio.sleep(TICK_RATE)[0m
[1;33m[จบโค้ด / แผนภาพ][0m

[0mโดย:[0m

[1;33m[โค้ด / แผนภาพ : text][0m
[32mTICK_RATE = 0.1[0m
[1;33m[จบโค้ด / แผนภาพ][0m

[90m----------------------------------------------------------------[0m

[1;36mทำไมใช้ await asyncio.sleep()?[0m
[90m------------------------------[0m

[0mเพราะต้องการ:[0m

[0mYield control กลับให้ Event Loop[0m

[0mแทนการใช้:[0m

[1;33m[โค้ด / แผนภาพ : python][0m
[32mtime.sleep()[0m
[1;33m[จบโค้ด / แผนภาพ][0m

[0mซึ่งจะ Block การทำงาน[0m

[0mเปรียบเทียบ:[0m

[1;33m[โค้ด / แผนภาพ : text][0m
[32masyncio.sleep()[0m
[32m      ↓[0m
[32mYield[0m
[32m      ↓[0m
[32mEvent Loop ทำ Task อื่นได้[0m
[1;33m[จบโค้ด / แผนภาพ][0m

[0mกับ:[0m

[1;33m[โค้ด / แผนภาพ : text][0m
[32mtime.sleep()[0m
[32m      ↓[0m
[32mBlock[0m
[32m      ↓[0m
[32mTask อื่นต้องรอ[0m
[1;33m[จบโค้ด / แผนภาพ][0m

[0m📌 หน้า 7: Non-blocking Sleep[0m


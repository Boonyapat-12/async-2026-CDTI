[0mเพื่อรับ Key Press[0m

[0mFlow:[0m

[1;33m[โค้ด / แผนภาพ : text][0m
[32mKeyboard[0m
[32m    │[0m
[32m    ▼[0m
[32mpynput Thread[0m
[32m    │[0m
[32m    ▼[0m
[32mKey Event[0m
[32m    │[0m
[32m    ▼[0m
[32mNon-blocking Send[0m
[32m    │[0m
[32m    ▼[0m
[32mRedis Publish[0m

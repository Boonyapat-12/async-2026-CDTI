[90m------------------[0m

[0mทำงานประมาณ:[0m

[1;33m[โค้ด / แผนภาพ : text][0m
[32m10 FPS[0m
[1;33m[จบโค้ด / แผนภาพ][0m

[0mหน้าที่:[0m

[1;33m[โค้ด / แผนภาพ : text][0m
[32mMove[0m
[32mFire[0m
[32mCollision[0m

[1;36m21. Flow รวมทั้งบท[0m
[90m==================[0m

[1;33m[โค้ด / แผนภาพ : text][0m
[32m             Async Tasks[0m
[32m                  │[0m
[32m                  ▼[0m
[32m          ┌───────────────┐[0m
[32m          │  Shared State │[0m
[32m          │    Coupon     │[0m
[32m          └───────┬───────┘[0m
[32m                  │[0m
[32m           หลาย Task เข้าถึง[0m
[32m                  │[0m
[32m                  ▼[0m
[32m           ┌─────────────┐[0m
[32m           │ await point │[0m
[32m           └──────┬──────┘[0m
[32m                  │[0m
[32m                  ▼[0m
[32m          Race Condition[0m
[32m                  │[0m
[32m                  ▼[0m
[32m          Data ผิด / ซ้ำ / Crash[0m
[32m                  │[0m
[32m                  │ แก้ด้วย[0m
[32m                  ▼[0m
[32m        ┌──────────────────┐[0m
[32m        │  asyncio.Lock    │[0m
[32m        │      Mutex       │[0m
[32m        └────────┬─────────┘[0m
[32m                 │[0m
[32m                 ▼[0m
[32m          Critical Section[0m
[32m          เข้าได้ทีละ Task[0m
[32m                 │[0m
[32m                 ▼[0m
[32m          Data Consistency[0m
[1;33m[จบโค้ด / แผนภาพ][0m

[90m----------------------------------------------------------------[0m

[1;36m22. สูตรวิเคราะห์ Code ข้อสอบ 🧠[0m
[90m===============================[0m

[0mเวลาเจอ Code Async ให้ไล่ตามนี้:[0m

[1;33m[โค้ด / แผนภาพ : text][0m
[32m① มี Shared State ไหม?[0m
[32m        ↓[0m
[32m② มีหลาย Task เข้าถึงไหม?[0m
[32m        ↓[0m
[32m③ มี await อยู่ระหว่าง Read/Modify/Write ไหม?[0m
[32m        ↓[0m
[32m④ ถ้ามี → มีโอกาส Race Condition[0m
[32m        ↓[0m
[32m⑤ Critical Section อยู่ตรงไหน?[0m
[32m        ↓[0m
[32m⑥ มี asyncio.Lock ครอบไหม?[0m
[32m        ↓[0m
[32m⑦ ถ้ามี → Task อื่นต้องรอ Lock[0m
[1;33m[จบโค้ด / แผนภาพ][0m

[90m----------------------------------------------------------------[0m

[1;36m23. จำแบบสั้นที่สุดก่อนสอบ ⭐⭐⭐[0m
[90m==============================[0m

[0mAsyncio = หลาย Task ทำงาน Concurrent บน Event Loop[0m

[0mSingle Thread ≠ ไม่มี Race Condition[0m

[0mawait = จุดที่ Task สามารถคืนการควบคุมให้ Event Loop[0m

[0mShared State = ข้อมูลที่หลาย Task เข้าถึงร่วมกัน[0m

[0mRace Condition = ผลลัพธ์ขึ้นกับจังหวะการสลับ Task[0m

[0mRead → await → Write = จุดเสี่ยงสำคัญ[0m

[0mCritical Section = ส่วนที่ต้องป้องกัน[0m

[0masyncio.Lock = Mutex สำหรับ Async Code[0m

[0mAcquire = ขอ/ถือ Lock[0m

[0mRelease = คืน Lock[0m

[0masync with lock = วิธีจัดการ Lock ที่แนะนำ[0m

[0mLock ต้องครอบ Critical Section[0m

[0mอย่า Lock Heavy I/O โดยไม่จำเป็น[0m

[0mเป้าหมายของ Lock = Data Consistency[0m

[90m----------------------------------------------------------------[0m

[1;36m24. ตารางจำเร็ว[0m
[90m===============[0m

[1;33m- คำศัพท์: Async Programming[0m
[0m  จำว่า: ทำหลายงานแบบ Concurrent[0m

[1;33m- คำศัพท์: Event Loop[0m
[0m  จำว่า: ตัวจัดการ Task[0m

[1;33m- คำศัพท์: await[0m
[0m  จำว่า: คืนการควบคุมให้ Event Loop[0m

[1;33m- คำศัพท์: Shared State[0m
[0m  จำว่า: ข้อมูลที่หลาย Task ใช้ร่วมกัน[0m

[1;33m- คำศัพท์: Race Condition[0m
[0m  จำว่า: ผลลัพธ์ขึ้นกับจังหวะ[0m

[1;33m- คำศัพท์: Read–Modify–Write[0m
[0m  จำว่า: รูปแบบที่เสี่ยง[0m

[1;33m- คำศัพท์: Critical Section[0m
[0m  จำว่า: โซนที่ต้องป้องกัน[0m

[1;33m- คำศัพท์: asyncio.Lock[0m
[0m  จำว่า: ตัวป้องกันการเข้าพร้อมกัน[0m

[1;33m- คำศัพท์: Acquire[0m
[0m  จำว่า: ขอ/รับ Lock[0m

[1;33m- คำศัพท์: Release[0m
[0m  จำว่า: คืน Lock[0m

[1;33m- คำศัพท์: async with lock[0m
[0m  จำว่า: ใช้ Lock อย่างปลอดภัย[0m

[1;33m- คำศัพท์: Mutex[0m
[0m  จำว่า: Mutual Exclusion[0m

[1;33m- คำศัพท์: server_vulnerable.py[0m
[0m  จำว่า: ไม่มี Lock[0m

[1;33m- คำศัพท์: server.py[0m
[0m  จำว่า: มี asyncio.Lock[0m

[1;33m- คำศัพท์: client.py[0m
[0m  จำว่า: ยิง Request Concurrent[0m


[90m----------------------------------------------------------------[0m

[1;36m25. จุดสำคัญที่สุดที่ควรเข้าใจ[0m
[90m==============================[0m

[0mถ้าต้องจำเพียงภาพเดียว ให้จำ:[0m

[1;33m[โค้ด / แผนภาพ : text][0m
[32mShared State[0m
[32m     │[0m
[32m     ▼[0m
[32mTask A ──────┐[0m
[32m             │[0m
[32m             ▼[0m
[32m           await[0m
[32m             │[0m
[32m             ▼[0m
[32mTask B ──────┤[0m
[32m             │[0m
[32m             ▼[0m
[32m     แก้ Shared State[0m
[32m             │[0m
[32m             ▼[0m
[32m      Race Condition[0m
[1;33m[จบโค้ด / แผนภาพ][0m

[0mวิธีแก้:[0m

[1;33m[โค้ด / แผนภาพ : text][0m
[32m             asyncio.Lock[0m
[32m                  │[0m
[32m                  ▼[0m

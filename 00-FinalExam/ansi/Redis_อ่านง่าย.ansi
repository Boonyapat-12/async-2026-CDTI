[32m                               │[0m
[32m             ┌─────────────────┼─────────────────┐[0m
[32m             │                 │                 │[0m
[32m             ▼                 ▼                 ▼[0m
[32m         Cache              Pub/Sub          Streams[0m
[32m             │                 │                 │[0m
[32m             │                 │                 ├──► Consumer[0m
[32m             │                 │                 ├──► Consumer[0m
[32m             │                 │                 └──► Consumer[0m
[32m             │                 │[0m
[32m             │                 └──► Subscribers[0m
[32m             │[0m
[32m             ▼[0m
